# ============================================================
# USD Revenue Tracker - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# Supabase Configuration
# 从 Supabase Dashboard -> Settings -> API 获取
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server Configuration
PORT=3000
NODE_ENV=production

# Site Configuration (GitHub Pages)
SITE_URL=https://lee-version.github.io/usd_investment_web

# MySQL Database Configuration (现有数据库，可迁移到Supabase后删除)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=usd_invest

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_MAX_AGE=604800000  # 7 days in milliseconds

# GitHub OAuth (可选，如果需要自定义实现)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
